#!/usr/bin/env bash

set -euo pipefail

readonly menu=(
  $'\U000F0425  Shutdown'
  $'\U000F0709  Reboot'
  $'\U000F02CA  Hibernate'
  $'\U000F04B2  Suspend'
  $'\U000F0343  Log out'
  $'\U000F033E  Screen lock'
  $'\U000F0379  Screen off'
)

confirm() {
  local choice
  choice=$(printf '%s\n' $'󰄬  Yes' $'󰅖  No' | fuzzel --dmenu --lines=2) || return 1
  [[ "$choice" == *"Yes" ]]
}

selection=$(printf '%s\n' "${menu[@]}" | fuzzel --dmenu --lines="${#menu[@]}") || exit 0

case "$selection" in
  *"Shutdown")
    confirm && systemctl poweroff
    ;;
  *"Reboot")
    confirm && systemctl reboot
    ;;
  *"Hibernate")
    systemctl hibernate
    ;;
  *"Suspend")
    systemctl suspend
    ;;
  *"Log out")
    confirm && niri msg action quit
    ;;
  *"Screen lock")
    if [[ -n "${XDG_SESSION_ID:-}" ]]; then
      loginctl lock-session "$XDG_SESSION_ID"
    else
      loginctl lock-session
    fi
    ;;
  *"Screen off")
    niri msg action power-off-monitors
    ;;
esac
